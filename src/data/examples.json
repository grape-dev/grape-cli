{
  "tasks_mine": "--status active --json-out",
  "tasks_create": "--json '{\"repo_key\":\"owner/repo\",\"title\":\"<title>\",\"description\":\"<desc>\"}'",
  "tasks_complete": "--json '{\"result_text\":\"<summary>\",\"next_step\":\"a2a_issue\"}'",
  "tasks_status": "--task_id 7 --json '{\"status\":\"processing\"}'",
  "tasks_status_get": "--task_id 7 --json-out",
  "tasks_start": "--task_id 7",
  "tasks_close": "--json '{\"repo_key\":\"owner/repo\",\"issue_number\":7}'",
  "tasks_notify": "--json '{\"assignee\":\"<user>\",\"repo_key\":\"owner/repo\",\"issue_number\":7}'",
  "tasks_clarify": "--task_id 7 --json '{\"message\":\"<your reply>\"}'",
  "tasks_clarifications": "--task_id 7 --json-out",
  "gitrepo_repo": "--owner o --repo r --json-out",
  "gitrepo_workspace": "--owner o --repo r --json-out",
  "gitrepo_git_credential": "--owner o --repo r --json-out",
  "gitrepo_branches": "--owner o --repo r --json-out",
  "gitrepo_commits": "--owner o --repo r --json-out",
  "gitrepo_contents": [
    "--owner o --repo r --path \"\" --json-out",
    "--owner o --repo r --path README.md --ref main --json-out"
  ],
  "gitrepo_labels_list": "--owner o --repo r --json-out",
  "gitrepo_labels_create": "--owner o --repo r --json '{\"name\":\"<label>\",\"color\":\"#d73a4a\"}'",
  "gitrepo_milestones": "--owner o --repo r",
  "gitrepo_issues_list": "--owner o --repo r --state open --json-out",
  "gitrepo_issues_create": "--owner o --repo r --json '{\"title\":\"<title>\",\"body\":\"<body>\"}'",
  "gitrepo_issues_get": "--owner o --repo r --number 7 --json-out",
  "gitrepo_issues_update": "--owner o --repo r --number 7 --json '{\"state\":\"closed\",\"labels\":\"bug\"}'",
  "gitrepo_issues_comments_list": "--owner o --repo r --number 7 --json-out",
  "gitrepo_issues_comments_create": "--owner o --repo r --number 7 --json '{\"body\":\"<comment>\"}'",
  "gitrepo_pulls_list": "--owner o --repo r --state open --json-out",
  "gitrepo_pulls_create": "--owner o --repo r --json '{\"title\":\"<title>\",\"head\":\"<branch>\",\"base\":\"main\"}'",
  "gitrepo_pulls_get": "--owner o --repo r --number 7 --json-out",
  "gitrepo_pulls_update": "--owner o --repo r --number 7 --json '{\"title\":\"<title>\"}'",
  "gitrepo_pulls_merge": "--owner o --repo r --number 7 --json-out",
  "gitrepo_pulls_comments_list": "--owner o --repo r --number 7 --json-out",
  "gitrepo_pulls_comments_create": "--owner o --repo r --number 7 --json '{\"body\":\"<comment>\"}'",
  "gitrepo_pulls_files": "--owner o --repo r --number 7 --json-out",
  "a2a_handoff": "--json '{\"agent\":\"issue\",\"payload\":{\"repository\":\"o/r\",\"account\":\"<user>\",\"issue_number\":7,\"pr_number\":0,\"context\":\"<ctx>\"}}'",
  "skills_list": "--json-out",
  "skills_detail": "--skill_id <id> --json-out",
  "scenes_list": "--json-out",
  "events_detail": "--event_id <id> --json-out",
  "agents_detail": "--json-out",
  "chat_conversations": "--json-out",
  "chat_messages": "--conversation_id <id> --json-out",
  "repos_member": "--json-out",
  "repos_managed": "--json-out",
  "knowledge_list": "--json-out",
  "auth_profile_get": "--json-out"
}